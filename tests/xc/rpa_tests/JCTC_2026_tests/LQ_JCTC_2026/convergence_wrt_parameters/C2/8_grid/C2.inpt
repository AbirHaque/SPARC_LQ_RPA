RPA_CALCULATION: 1
LATVEC_SCALE: 3.364425 3.364425 3.364425  # if CELL is used, then the program will fail in function read_vec_cube -> check_lattice #10.287
FD_GRID: 8 8 8
#MESH_SPACING: 0.15
FD_ORDER: 12
BC: P P P
KPOINT_GRID: 1 1 1
KPOINT_SHIFT: 0 0 0
EXCHANGE_CORRELATION: GGA_PBE
ELEC_TEMP_TYPE: fd
SMEARING: 0.000001
TOL_SCF: 1e-5
MAXIT_SCF: 100
# TOL_PSEUDOCHARGE: 1e-6
MIXING_VARIABLE: density
MIXING_PRECOND: kerker
NSTATES: 10 # for generating chi0, n=390 stopped
PRINT_FORCES: 1
# PRINT_ATOMS: 1
PRINT_EIGEN: 1
PRINT_DENSITY: 1
PRINT_ORBITAL: 2
