#=========================
# format of ion file
#=========================
# ATOM_TYPE: <atom type name> 
# N_TYPE_ATOM: <num of atoms of this type>
# COORD:
# <xcoord> <ycoord> <zcoord>
# ...
# RELAX:
# <xrelax> <yrelax> <zrelax>
# ...


# Reminder: when changing number of atoms, change the RELAX flags accordingly
#           as well.
ATOM_TYPE: H
PSEUDO_POT: ../01_H_1_1.0_1.0_pbe_v1.0.psp8
N_TYPE_ATOM: 1
COORD_FRAC: 
   0.500    0.500    0.500


ATOM_TYPE: Li
PSEUDO_POT: ../03_Li_3_1.6_1.6_pbe_v1.0.psp8
N_TYPE_ATOM: 1
COORD_FRAC: 
   0.000    0.000    0.000

